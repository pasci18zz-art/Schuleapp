<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:clipToOutline="true"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/study_kind"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_glass"
            android:contentDescription="Art wechseln"
            android:padding="8dp"
            android:src="@drawable/ic_w_pen" />

        <FrameLayout
            android:layout_width="10dp"
            android:layout_height="1dp" />

            <Chronometer
                android:id="@+id/study_timer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/study_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_btn_accent"
                android:contentDescription="Start oder Pause"
                android:padding="10dp"
                android:src="@drawable/ic_w_play" />

            <FrameLayout
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/study_stop"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn_glass"
                android:contentDescription="Beenden"
                android:padding="10dp"
                android:src="@drawable/ic_w_stop" />
    </LinearLayout>
</FrameLayout>
