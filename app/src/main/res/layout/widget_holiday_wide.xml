<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/hol_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_round_fill" />
        <ImageView
            android:id="@+id/hol_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_h_tree" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">
        <TextView
    android:id="@+id/hol_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Weihnachtsferien"
    android:textColor="#FFFFFFFF"
    android:textSize="16sp" android:textStyle="bold"
     />
        <TextView
    android:id="@+id/hol_date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="ab Mi, 23. Dez"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp"
     />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
    android:id="@+id/hol_days"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="53"
    android:textColor="#FFFFFFFF"
    android:textSize="30sp" android:textStyle="bold"
    android:includeFontPadding="false" />
        <TextView
    android:id="@+id/hol_days_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Tage"
    android:textColor="#CCFFFFFF"
    android:textSize="12sp"
     />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
