<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="16dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
    android:id="@+id/exam_pen"
    android:layout_width="20dp"
    android:layout_height="20dp"
    
    android:importantForAccessibility="no"
    android:padding="0dp"
    android:src="@drawable/ic_k_pen"
     />
        <TextView
            android:id="@+id/exam_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="Mo, 3. Nov"
            android:textColor="#BFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
    android:id="@+id/exam_icon"
    android:layout_width="24dp"
    android:layout_height="24dp"
    
    android:importantForAccessibility="no"
    android:padding="0dp"
    android:src="@drawable/ic_s_kunst"
     />
        <TextView
            android:id="@+id/exam_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:text="Kunst"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
    android:id="@+id/exam_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Klausur"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp"
     />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
    android:id="@+id/exam_days"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="3"
    android:textColor="#FFFF7A59"
    android:textSize="40sp" android:textStyle="bold"
    android:includeFontPadding="false" />
        <TextView
    android:id="@+id/exam_days_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Tage"
    android:textColor="#CCFFFFFF"
    android:textSize="15sp"
    android:paddingStart="6dp"
    android:paddingBottom="4dp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/exam_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/widget_progress" />
    <TextView
    android:id="@+id/exam_info"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="40 % gelernt"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp"
    android:layout_marginTop="4dp" />
</LinearLayout>
</FrameLayout>
